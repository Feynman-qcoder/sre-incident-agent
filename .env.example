# 环境变量模板 —— 复制为 .env 后填写：
#   cp .env.example .env
#
# 约定：
#   · 「必填」项留空，等待填写（未填写时会启动失败，属预期行为）；
#   · 其余项已注释 —— 代码内置默认值可直接工作，需要覆盖时取消注释即可
#     （请勿写成空值：`KEY=` 会覆盖默认值，可能引发 int("") 之类的运行时错误）。

# ── LLM（必填；任何 OpenAI 兼容端点均可）────────────────────
NIM_API_KEY=
NIM_BASE_URL=
NIM_MODEL=

# ── 可观测后端（默认指向本地 NodePort，见 deploys/）─────────
# PROMETHEUS_URL=http://localhost:9090
# TEMPO_URL=http://localhost:3200
# LOKI_URL=http://localhost:3100

# ── Kubernetes ─────────────────────────────────────────────
# KUBECONFIG=/absolute/path/to/.kube/config   # 注意：~ 不会被展开，须绝对路径
# K8S_NAMESPACE=otel-demo

# ── 评测参数（取消注释即覆盖代码默认值）────────────────────
# CONTEXT_BUDGET_TOKENS=28000
# MAX_TOOL_ITERATIONS=8
# CHAOS_SEED=42
# NUMPY_SEED=42
# RANDOM_SEED=42
